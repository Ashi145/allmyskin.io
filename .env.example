# Public PayPal client ID (safe to expose in the browser). Capture/verification
# must still happen on your payment backend before fulfilling an order.
VITE_PAYPAL_CLIENT_ID=

# HTTPS endpoint that subscribes an email address to your email platform.
# It receives JSON: { email, source, marketingConsent }. Keep provider API keys
# only inside that endpoint; do not put them in this file or in GitHub Pages.
VITE_NEWSLETTER_ENDPOINT=
